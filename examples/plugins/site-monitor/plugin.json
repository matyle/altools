{
  "id": "site-monitor",
  "name": "Site monitor",
  "version": "1.0.0",
  "author": "Altools",
  "description": "No UI: a notch alert only when a website goes down or comes back. A stream plugin.",
  "api": 1,
  "icon": "antenna.radiowaves.left.and.right",
  "tint": "#56B6C2",
  "run": "run.sh",
  "mode": "stream",
  "slots": ["alerts"],
  "settings": [
    { "key": "url", "title": "Website", "type": "text", "default": "https://github.com" },
    { "key": "every", "title": "Check every (seconds)", "type": "choice", "options": ["15", "30", "60", "300"], "default": "30" }
  ]
}
